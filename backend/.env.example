PORT=5000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/jwt_auth_db

# 256-bit secret used to sign and verify short-lived access tokens (15m expiry)
ACCESS_TOKEN_SECRET=replace_this_with_a_super_strong_random_secret_at_least_32_characters_long

# Explicit frontend URL allowed to communicate via CORS with credentials (cookies)
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
